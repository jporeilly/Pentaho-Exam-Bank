# ── Python ───────────────────────────────────────────────────
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── Secrets / local config ───────────────────────────────────
.env

# ── Runtime / user data (regenerated by the app) ─────────────
# Database + backups, local config.json, cached PPTX uploads,
# exported question files, temp + settings — all machine/user state.
assets/

# ── Editor / agent ───────────────────────────────────────────
.claude/
.vscode/
.idea/

# Front end (0.4.0 restack)
node_modules/
frontend/dist/

# ── Desktop packaging (Phase 4) ──────────────────────────────
# The vendored Python runtime (~148 MB), the staged app tree, the Rust
# build output and Tauri's generated files. All of them are BUILD
# ARTEFACTS produced by desktop/scripts - what gets committed is the
# recipe, never its output.
desktop/node_modules/
desktop/src-tauri/vendor/
desktop/src-tauri/target/
desktop/src-tauri/gen/

# ── Built installers ─────────────────────────────────────────────────
# Collected by desktop/scripts/collect-installer.ps1, one per version.
# ROOT-ANCHORED: a bare "dist/" would also match desktop/dist/, which is
# the Tauri startup page and IS tracked, and frontend/dist/, which is
# already ignored above for its own reasons.
/dist/
