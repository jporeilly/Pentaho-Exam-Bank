{
  "about": "The inline formatting contract. Question text may carry **bold**, *italic* and `code`, nothing else, and never HTML. The Exam Bank's TypeScript (inlineFormat.tsx) and Python (exam_bank/core/inline_format.py) parsers are both tested against these cases, and the Content Manager's quiz renderer (src/components/inlineFormat.tsx there) carries a copy of this file: change one, change all three. Nodes: [\"text\", s] | [\"strong\", nodes] | [\"em\", nodes] | [\"code\", s].",
  "cases": [
    { "in": "plain text", "nodes": [["text", "plain text"]] },
    { "in": "", "nodes": [] },
    { "in": "a **bold** word", "nodes": [["text", "a "], ["strong", [["text", "bold"]]], ["text", " word"]] },
    { "in": "an *italic* word", "nodes": [["text", "an "], ["em", [["text", "italic"]]], ["text", " word"]] },
    { "in": "the `kettle.properties` file", "nodes": [["text", "the "], ["code", "kettle.properties"], ["text", " file"]] },
    { "in": "**bold with *italic* inside**", "nodes": [["strong", [["text", "bold with "], ["em", [["text", "italic"]]], ["text", " inside"]]]] },
    { "in": "*italic with **bold** inside*", "nodes": [["em", [["text", "italic with "], ["strong", [["text", "bold"]]], ["text", " inside"]]]] },
    { "in": "***both***", "nodes": [["strong", [["em", [["text", "both"]]]]]] },
    { "in": "**bold `code` bold**", "nodes": [["strong", [["text", "bold "], ["code", "code"], ["text", " bold"]]]] },
    { "in": "doesn't *perform* the standardization;", "nodes": [["text", "doesn't "], ["em", [["text", "perform"]]], ["text", " the standardization;"]] },
    { "in": "(*so*), and **this**.", "nodes": [["text", "("], ["em", [["text", "so"]]], ["text", "), and "], ["strong", [["text", "this"]]], ["text", "."]] },

    { "in": "[Measures].[Sales] * [Measures].[Quantity]", "nodes": [["text", "[Measures].[Sales] * [Measures].[Quantity]"]] },
    { "in": "the formula {QUANTITYORDERED}*{PRICEEACH}", "nodes": [["text", "the formula {QUANTITYORDERED}*{PRICEEACH}"]] },
    { "in": "industrial/*/sensor", "nodes": [["text", "industrial/*/sensor"]] },
    { "in": "$.customer.email[*]", "nodes": [["text", "$.customer.email[*]"]] },
    { "in": "$.orders[*].customer.email selects each; $.customer.email[*] does not", "nodes": [["text", "$.orders[*].customer.email selects each; $.customer.email[*] does not"]] },
    { "in": "'$.customers[*].region_code' and '$.customers.*.region.code'", "nodes": [["text", "'$.customers[*].region_code' and '$.customers.*.region.code'"]] },
    { "in": "*.ktr and *.kjb files", "nodes": [["text", "*.ktr and *.kjb files"]] },
    { "in": "a/*/b/*/c", "nodes": [["text", "a/*/b/*/c"]] },
    { "in": "a '*quoted*' word", "nodes": [["text", "a '"], ["em", [["text", "quoted"]]], ["text", "' word"]] },
    { "in": "**Note:** read this", "nodes": [["strong", [["text", "Note:"]]], ["text", " read this"]] },
    { "in": "*'quoted'* and *Correct.* and **$PENTAHO_HOME**", "nodes": [["em", [["text", "'quoted'"]]], ["text", " and "], ["em", [["text", "Correct."]]], ["text", " and "], ["strong", [["text", "$PENTAHO_HOME"]]]] },
    { "in": "a*b and c*d", "nodes": [["text", "a*b and c*d"]] },
    { "in": "2 * 3 * 4", "nodes": [["text", "2 * 3 * 4"]] },
    { "in": "file*name* here", "nodes": [["text", "file*name* here"]] },
    { "in": "a**b** c", "nodes": [["text", "a**b** c"]] },
    { "in": "x *y*z", "nodes": [["text", "x *y*z"]] },
    { "in": "** not bold **", "nodes": [["text", "** not bold **"]] },
    { "in": "* not italic *", "nodes": [["text", "* not italic *"]] },
    { "in": "**unclosed bold", "nodes": [["text", "**unclosed bold"]] },
    { "in": "a lone ` backtick", "nodes": [["text", "a lone ` backtick"]] },
    { "in": "empty `` code", "nodes": [["text", "empty `` code"]] },
    { "in": "snake_case and JAVA_ and _fr", "nodes": [["text", "snake_case and JAVA_ and _fr"]] },
    { "in": "__not bold__", "nodes": [["text", "__not bold__"]] },
    { "in": "<div id=\"panel_1\"></div> & <b>no</b>", "nodes": [["text", "<div id=\"panel_1\"></div> & <b>no</b>"]] },

    { "in": "`**not bold in code**`", "nodes": [["code", "**not bold in code**"]] },
    { "in": "`${variable_name}` syntax", "nodes": [["code", "${variable_name}"], ["text", " syntax"]] },
    { "in": "an escaped \\*star\\* stays", "nodes": [["text", "an escaped *star* stays"]] },
    { "in": "an escaped \\` tick", "nodes": [["text", "an escaped ` tick"]] },
    { "in": "a backslash \\\\ stays", "nodes": [["text", "a backslash \\ stays"]] },
    { "in": "C:\\Pentaho\\server", "nodes": [["text", "C:\\Pentaho\\server"]] },
    { "in": "line one\n**line two**", "nodes": [["text", "line one\n"], ["strong", [["text", "line two"]]]] },
    { "in": "**Ünïcödé** wörds", "nodes": [["strong", [["text", "Ünïcödé"]]], ["text", " wörds"]] }
  ]
}
