{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Pentaho Exam Bank",
  "version": "1.5.1",
  "identifier": "com.pentaho.exam-bank",
  "build": {
    "beforeBuildCommand": "npm run build:ui && npm run fetch:python && npm run stage:app",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pentaho Exam Bank",
        "width": 1440,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "vendor/python": "python",
      "vendor/app": "app",
      "../scripts/find-courses.ps1": "provisioning/find-courses.ps1"
    },
    "category": "Education",
    "shortDescription": "Write, review and publish Pentaho certification exam questions",
    "longDescription": "Generates certification exam questions from Pentaho Content Manager course content, holds them in a reviewable bank, and publishes them back into a course's exam.json without touching the settings the Content Editor owns. Also exports QTI 2.1, Moodle XML, CSV, Word and printable PDF papers weighted across topics.",
    "publisher": "Pentaho Presales Engineering",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  },
  "plugins": {}
}
